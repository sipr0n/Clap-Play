# Copie ce fichier en .env.local (en local) et ajoute les mêmes variables dans Vercel.

# TMDB : catalogue de films + disponibilité sur les plateformes (gratuit)
# https://www.themoviedb.org/settings/api → « Jeton d'accès en lecture à l'API »
TMDB_API_KEY=

# Supabase : comptes, connexion Google, base de données (gratuit)
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
